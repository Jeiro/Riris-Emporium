# Public frontend settings only. Copy to ignored .env.local after target approval.
# Never assume an existing project is development. See docs/DEVELOPMENT-WORKFLOW.md.
VITE_SUPABASE_URL=https://<approved-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=<public-supabase-publishable-key>
# Alternative public key; do not set both unless compatibility requires it:
# VITE_SUPABASE_ANON_KEY=<public-supabase-anon-key>

# Prepared Clerk replacement only; a key does not activate it.
VITE_CLERK_PUBLISHABLE_KEY=<public-clerk-development-publishable-key>

# WhatsApp-only checkout needs no payment provider key or API secret.
# No database passwords, service-role keys or Clerk secret keys belong here.
